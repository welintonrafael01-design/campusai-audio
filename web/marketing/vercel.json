{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.studybookai.com" }],
      "destination": "https://studybookai.com/:path*",
      "permanent": true
    }
  ]
}
